# Dependencies
node_modules/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
config.conf
*.env

# Database (keep folder but ignore contents)
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# User Uploads
uploads/*
!uploads/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Config examples (don't ignore these, keep them for reference)
!config.conf.example

# Build artifacts
public/chess.js
dist/
build/
client/dist/
client/node_modules/

# Vite/React
*.local

# Coverage
coverage/

# Misc
*.tgz
*.tmp
*.temp

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# Runtime data
*.pid
*.seed
*.pid.lock

# Cache
.cache/
.npm/

# Scratch space for tooling (playwright screenshots, build probes)
tmp/

# NOTE: package-lock.json is intentionally NOT ignored.
# The Dockerfile runs `npm ci` in both /app and /app/client, which requires a
# committed lockfile. Ignoring it (as v0.0.2 did) made the image unbuildable.
