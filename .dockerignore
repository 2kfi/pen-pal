# Keep the build context small and reproducible.
# Critically: node_modules here would shadow the clean `npm ci` inside the image,
# and data/ + uploads/ are host state that must never be baked into a layer.

.git
.github
.gitignore

node_modules
client/node_modules

# Host runtime state
data
uploads
# Where scripts/backup.sh writes by default. Host state, and it can be large:
# uploading a developer's local backups to the builder is slow and pointless.
backups

# Scratch
tmp
dist
client/dist

# Docs and design artifacts are not needed to build or run
docs
*.md
!server/**/*.md
photos

# Vite/env noise
.env
.env.*
!.env.example
*.local
.vscode
.idea
.DS_Store
*.log
npm-debug.log*