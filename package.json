{
  "name": "pen-pal-archive",
  "version": "2.0.0",
  "description": "Private encrypted letter exchange app inspired by Slowly",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "lint": "node --check server/index.js && node --check server/db.js",
    "design:check": "node tools/check-contrast.mjs && node tools/check-docs.mjs",
    "test": "vitest run",
    "backup": "bash scripts/backup.sh",
    "backup:list": "node scripts/ops-db.js list",
    "backup:verify": "node scripts/ops-db.js verify",
    "restore": "bash scripts/restore.sh",
    "migrate:status": "node scripts/migrate-status.js",
    "e2e": "python3 tests/e2e/app.spec.py",
    "e2e:setup": "python3 -m pip install playwright && python3 -m playwright install --with-deps chromium",
    "build": "node --check server/index.js && node --check server/db.js",
    "brand:build": "node tools/build-brand.mjs && python3 tools/build-og.py"
  },
  "keywords": [
    "letters",
    "encryption",
    "e2e",
    "pen-pal"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true
  }
}
