# Copy to .env and fill in. Never commit .env.
PORT=3000

# REQUIRED. Generate with: openssl rand -base64 32
# The server refuses to boot in production if this is unset or left at a default.
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32

# Comma-separated allowlist. Leave unset for same-origin only.
CORS_ORIGIN=http://localhost:3000

# Enables POST /api/admin/reset-db. Non-production only; ignored in prod.
ADMIN_TOKEN=

# Where the SQLite file lives. Defaults to ./data
# DATA_DIR=/app/data

# ------------------------------------------------------------------
# HTTPS is not optional if you want working encryption.
#
# WebCrypto (crypto.subtle) is unavailable outside a secure context, so serving
# PenPal over plain http://192.168.x.x disables end-to-end encryption entirely.
# The app refuses to fall back to plaintext — it will simply refuse to send.
#
# Put it behind a TLS-terminating reverse proxy (Caddy is the easy option):
#
#   your-penpal.example.com {
#     reverse_proxy localhost:3000
#   }
# ------------------------------------------------------------------