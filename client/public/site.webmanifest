{
  "name": "PenPal",
  "short_name": "PenPal",
  "description": "A letter takes time. That is the feature.",
  "start_url": "/letters",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0a0a0c",
